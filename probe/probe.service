# /etc/systemd/system/probe.service: probe.1ms.dog (see probe/main.go)
[Unit]
Description=probe.1ms.dog: connection readings for who.1ms.dog
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/probe/probe -addr :443 -domain probe.1ms.dog -certs /var/lib/probe/certs
Restart=always
RestartSec=2
# (only what it needs: port 443 and a raw socket for the SYN capture; its own output is startup and errors only)
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
DynamicUser=yes
StateDirectory=probe
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
